# Firebase (Project settings → Your apps → Web app config)
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Google Analytics in Firebase
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── FastAPI (incidents, summary, stats, admin, …) ─────────────────────────
# Local: leave NEXT_PUBLIC_API_URL empty. `next dev` rewrites /api/* → BACKEND_URL.
# BACKEND_URL=http://127.0.0.1:8765
#
# Production (Vercel www + API on another host, e.g. api.phlpulse.com):
# 1) BACKEND_URL — **required on Vercel**. Full origin of FastAPI, no trailing slash.
#    Example: BACKEND_URL=https://api.phlpulse.com
#    If unset, rewrites default to localhost and https://www.../api/* returns 404.
# 2) NEXT_PUBLIC_API_URL — optional, often same as API. Browser uses same-origin /api/*
#    when possible (see public-api-base.ts) so Vercel proxies and avoids CORS.
# 3) If the API host returns 502, fix reverse proxy/uvicorn first. Browsers may show
#    "CORS" on cross-origin fallbacks because error pages lack ACAO headers.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Stripe (for Pro tier subscriptions + 3-day pass)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices for the CityPulse Pro subscription product.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# One-time price for the CityPulse Pro 3-Day Pass product. Must be a
# `mode: payment` price (One-time billing in the Stripe dashboard) —
# if you accidentally paste a recurring price here the 3-day flow
# will create an auto-renewing subscription instead of a finite pass.
STRIPE_PRICE_3DAY=

# Firebase Admin (for Stripe webhook → Firestore user tier updates)
# JSON-stringified service account key, or leave empty if running in a GCP environment with default credentials
# FIREBASE_ADMIN_KEY=

# City config
# NEXT_PUBLIC_CITY_SLUG=philly
# NEXT_PUBLIC_CITY_NAME=Philadelphia
# NEXT_PUBLIC_SITE_NAME=PHLPulse
