[Unit]
Description=Pulse Backfill Cron — rotating cities
After=network.target philly-pulse-api.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/PhillyPulse
EnvironmentFile=/etc/philly-pulse.env
Environment=GOOGLE_APPLICATION_CREDENTIALS=/root/firebase-sa.json
ExecStart=/root/PhillyPulse/venv/bin/python3 -u backfill_smart.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pulse-backfill

[Install]
WantedBy=multi-user.target
