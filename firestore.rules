rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin allow-list. Keep in sync with ADMIN_EMAILS in
    // frontend/src/contexts/AuthContext.tsx — both the moderation
    // UI and these rules consult the same canonical list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
            'eliyoung4now@gmail.com',
            'kethansany@gmail.com',
            'rickywhy@gmail.com'
          ];
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow write: if false;
    }
    match /extractions/{extractionId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';

      match /savedDestinations/{destId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }

      // Cross-device user preferences synced by frontend/src/lib/prefs-sync.ts.
      // Stored at users/{uid}/userPrefs/{docId} (currently a single
      // doc id "v1"). Owner-only read/write; non-anonymous required so
      // we always have a stable account to mirror the prefs against.
      // Without this rule the prefs sync silently fails with
      // "Missing or insufficient permissions" for every signed-in
      // user, leaving prefs un-syncable across devices.
      match /userPrefs/{prefDocId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // Live ETA share: a sender publishes their position + ETA so a
    // recipient can watch them arrive. The share ID is a 12-char
    // base32 token that's effectively unguessable, so public read is
    // acceptable — recipients have to be sent the link out-of-band.
    // Writes are owner-only. Set a TTL policy on `expiresAt` in the
    // Firebase console so stale shares auto-purge after 4h.
    match /liveTrips/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // Crowdsourced safety reports. Public-read so any visitor sees
    // the markers; create-write requires a non-anonymous account so
    // we always have a uid to attribute (and to ban, if needed).
    // Updates aren't allowed — reports are immutable; the owner can
    // delete and re-submit. Schema is validated to keep the payload
    // bounded (no 1MB notes) and to prevent spoofed ownerUids.
    // Set a TTL policy on `expiresAt` in the Firebase console so
    // stale reports auto-purge after 4h even if no client cleans
    // them up.
    // In-app feedback / bug reports. Anyone (including anonymous and
    // signed-out visitors) may create a record so users can report
    // issues even if sign-in itself is what's broken. Reads are
    // restricted to the admin allow-list, kept in sync with the
    // ADMIN_EMAILS list in AuthContext.tsx. No updates/deletes
    // allowed from the client — admins manage triage from the
    // Firebase console.
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.kind in ['bug', 'feature', 'praise', 'other']
        && (!('contactEmail' in request.resource.data)
            || request.resource.data.contactEmail == null
            || (request.resource.data.contactEmail is string
                && request.resource.data.contactEmail.size() <= 254));
      // Admins may move a row through its triage states. We restrict
      // the diff so they can't accidentally rewrite the original
      // message or owner attribution — the moderation surface is for
      // managing state, not editing the user's words.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'triagedAt'])
        && request.resource.data.status in ['new', 'triaged', 'resolved', 'wontfix'];
      allow delete: if isAdmin();
    }

    // Append-only audit log of admin moderation actions. Admins can
    // create entries (and read them all back); nobody can update or
    // delete. The moderation surface writes one row per destructive
    // action so we have a tamper-evident trail of "who did what,
    // when" — necessary for both internal accountability and any
    // future "I didn't post that" appeals from users.
    //
    // Hard purges (e.g. legal-hold scrubs) must be done from the
    // Firebase console with explicit intent; deny-from-client is the
    // safer default.
    match /moderationAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.kind in [
            'feedback.delete', 'feedback.status'
          ]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 200;
      allow update, delete: if false;
    }

    // Lifecycle aggregates for scanner incidents — "is this still
    // happening?" votes. The parent doc id matches the incident id
    // exactly so a one-shot getDoc resolves the status. The doc is
    // either created by the first voter or updated by subsequent
    // voters; the rules constrain writes to the four aggregate
    // fields so a malicious client can't stuff arbitrary keys in.
    // Reads are public so the UI can show "STILL HAPPENING · 3 in
    // last hour" badges without authentication.
    match /incidentStatus/{incidentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(
            ['incidentId', 'stillCount', 'resolvedCount', 'lastVoteAtMs', 'lastVoterUid']
          )
        && request.resource.data.stillCount is number
        && request.resource.data.resolvedCount is number
        && request.resource.data.stillCount >= 0
        && request.resource.data.resolvedCount >= 0
        && request.resource.data.lastVoterUid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stillCount', 'resolvedCount', 'lastVoteAtMs', 'lastVoterUid'])
        && request.resource.data.stillCount is number
        && request.resource.data.resolvedCount is number
        && request.resource.data.stillCount >= 0
        && request.resource.data.resolvedCount >= 0
        && request.resource.data.lastVoterUid == request.auth.uid;
      allow delete: if isAdmin();

      // Per-voter records under each incident. Voter doc id MUST be
      // the voter's uid (prevents double voting); the value field is
      // restricted to "still" or "resolved" so callers can't sneak
      // a sentinel value past the validation. There's no
      // self-vote-prevention here because scanner incidents have no
      // owner — anyone may vote.
      match /votes/{voterUid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == voterUid
          && request.resource.data.value in ['still', 'resolved'];
        allow delete: if request.auth != null
          && request.auth.uid == voterUid;
      }
    }

    // Web Push subscriptions. Written exclusively by the backend
    // service account via Firebase Admin SDK (which bypasses these
    // rules), so no client-side path is needed for create/update.
    // Owners can read their own row to confirm registration; admins
    // can read all rows for auditing dead endpoints. Owners can also
    // delete their own row as a "panic unsubscribe" path that
    // doesn't require the backend to be reachable.
    match /pushSubscriptions/{subId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // Pro-only keyword scanner watches. Owner can read/list their own
    // and delete any of them (so a downgraded user can still clean up
    // after losing Pro). Create/update are *server-only*: the FastAPI
    // tier-enforced endpoints write via the Admin SDK and bypass
    // these rules. We deliberately don't try to enforce the Pro
    // gate here because the user's tier lives in `users/{uid}.tier`
    // and rules can't easily get/lookup that across collections
    // without making every write expensive.
    match /keywordWatches/{watchId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // Server-side commute predictions. The client uploads its own
    // schedule (one doc per uid+bucket) so the backend cron can
    // fire the same nudge whether the tab is open or fully closed.
    // Schema:
    //   uid                      string  (== request.auth.uid)
    //   bucketKey                string
    //   destLat, destLng         number
    //   destLabel                string
    //   matchedCategory          string ("home" | "work" | null)
    //   typicalDepartureMinute   number  0..1439
    //   typicalDurationMin       number
    //   isWeekend                bool
    //   confidence               number  0..1
    //   tz                       string  IANA timezone
    //   updatedAt                number  (client epoch ms)
    //   lastFiredYmd             string  (server-only; client never sets)
    //   lastFiredAtMs            number  (server-only)
    match /commuteSchedules/{scheduleId} {
      allow read, delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource.data.uid == request.auth.uid;
      // Create / update by the schedule's owner. Field allowlist
      // keeps the document tight; the server-side `lastFired*` fields
      // are written by the FastAPI tick endpoint with the Admin SDK
      // (which bypasses these rules) and must NOT be settable by a
      // malicious client (otherwise they could permanently suppress
      // their own commute pings, or worse, someone else's).
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','bucketKey','destLat','destLng','destLabel',
          'matchedCategory','typicalDepartureMinute','typicalDurationMin',
          'isWeekend','confidence','tz','updatedAt'
        ])
        && request.resource.data.typicalDepartureMinute is number
        && request.resource.data.typicalDepartureMinute >= 0
        && request.resource.data.typicalDepartureMinute < 1440
        && request.resource.data.confidence is number;
    }
  }
}
