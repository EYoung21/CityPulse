rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /incidents/{incidentId} {
      allow read: if true;
      allow write: if false;
    }
    match /extractions/{extractionId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';

      match /savedDestinations/{destId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // Live ETA share: a sender publishes their position + ETA so a
    // recipient can watch them arrive. The share ID is a 12-char
    // base32 token that's effectively unguessable, so public read is
    // acceptable — recipients have to be sent the link out-of-band.
    // Writes are owner-only. Set a TTL policy on `expiresAt` in the
    // Firebase console so stale shares auto-purge after 4h.
    match /liveTrips/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }
  }
}
